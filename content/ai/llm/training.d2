grid-rows: 3
grid-columns: 2
grid-gap: 40

data: "text from the web,\nbooks, and code"
pre: "pretraining\npredict the next token"
base: "base model"
sft: "supervised fine-tuning\nexample conversations"
rl: "reinforcement learning\nfrom feedback"
chat: "chat model"

data -> pre -> base -> sft -> rl -> chat
