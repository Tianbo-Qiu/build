grid-rows: 1
grid-columns: 2
grid-gap: 70

l: "" {
  style.fill: transparent
  style.stroke: transparent
  grid-columns: 1
  vertical-gap: 90
  horizontal-gap: 0
  set: "test set:\nchart requests,\nno single right answer"
  app: "application\n(version A or B)"
  chart: "one chart"
  set -> app: "one request"
  app -> chart
}
r: "" {
  style.fill: transparent
  style.stroke: transparent
  grid-columns: 1
  vertical-gap: 90
  horizontal-gap: 0
  person: "a person grades\na sample of charts"
  judge: "LLM judge\nanswers each check"
  grade: "rubric for this chart" {
    grid-rows: 5
    grid-columns: 2
    grid-gap: 0
    c1: "has a title"
    v1: "yes"
    c2: "axes labeled"
    v2: "yes"
    c3: "chart type suits data"
    v3: "yes"
    c4: "legend names every series"
    v4: "no"
    c5: "no overlapping text"
    v5: "yes"
  }
  score: "score: 4 of 5\naveraged over the test set,\nper version"
  person -> judge: "do their grades\nagree?"
  judge -> grade
  grade -> score
}
l.chart -> r.judge

**.style.font-size: 18
(** -> **)[*].style.font-size: 18
