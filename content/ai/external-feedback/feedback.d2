grid-rows: 1
grid-columns: 2
grid-gap: 32

self: "self-critique" {
  direction: down
  d: "draft"
  c: "LLM critiques:\nsame weights,\nsame prompt"
  r: "revision:\nno new facts"
  d -> c -> r
}
ext: "external feedback" {
  direction: down
  d: "draft"
  c: "check outside the LLM:\nrun, match, count,\nor look up"
  r: "revision:\nwith new facts"
  d -> c -> r
}

**.style.font-size: 16
