grid-rows: 4
grid-columns: 2
grid-gap: 70

req: "request: an image of a girl\nreading, in the pose of the\nboy in boy.jpg, then\ndescribe it aloud"
s1: "1 pose detection\non boy.jpg"
plan: "LLM plans the steps\nand picks a model\nfor each"
s2: "2 pose-to-image:\ngirl reading a book"
gap: "" {style.opacity: 0}
s3: "3 image-to-text:\ncaption the new image"
out: "LLM sums up\nthe results\nfor the user"
s4: "4 text-to-speech:\nread the caption"

req -> plan
plan -> s1
s1 -> s2: "pose"
s2 -> s3: "image"
s3 -> s4: "caption"
s4 -> out: "audio"
