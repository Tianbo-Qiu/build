grid-rows: 2
grid-gap: 48

mono: "monolith: one process, one deploy" {
  direction: down
  app: "application" {
    grid-columns: 3
    grid-gap: 110
    o: "orders\nmodule"
    p: "payments\nmodule"
    u: "users\nmodule"
    o -> p: "function\ncall"
  }
  db: "one database" {shape: cylinder}
  app -> db
}
micro: "microservices: many processes, separate deploys" {
  grid-rows: 2
  grid-columns: 3
  horizontal-gap: 110
  vertical-gap: 60
  o: "orders\nservice"
  p: "payments\nservice"
  u: "users\nservice"
  odb: "orders DB" {shape: cylinder}
  pdb: "payments DB" {shape: cylinder}
  udb: "users DB" {shape: cylinder}
  o -> odb
  u -> udb
  p -> pdb
  o -> p: "network\ncall"
}
