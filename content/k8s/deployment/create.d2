grid-rows: 2
grid-columns: 2
grid-gap: 110
horizontal-gap: 70
(** -> **)[*].style.font-size: 20

you: Your computer {
  label.near: top-left
  kubectl: kubectl
}

hub: Docker Hub {
  shape: cylinder
}

cp: Control plane {
  label.near: top-left
  api: API server {
    label.near: top-left
    dep: "Deployment\nweb"
    rs: "ReplicaSet\nweb-6d4cf56db6"
    pod: "Pod\nweb-6d4cf56db6-x8r2k"
    dep -> rs: "2. create"
    rs -> pod: "3. create"
  }
}

node: Worker node {
  label.near: top-left
  grid-rows: 2
  grid-columns: 2
  grid-gap: 60
  kubelet: kubelet
  runtime: "container\nruntime"
  gap: "" {style.opacity: 0}
  c: "nginx\ncontainer"
  kubelet -> runtime: "5. run"
  runtime -> c: "7. start"
}

you.kubectl -> cp.api.dep: "1. create"
cp.api.pod -> node.kubelet: "4. bound to\nthis node" {style.stroke-dash: 4}
hub -> node.runtime: "6. pull\nnginx:1.27"
