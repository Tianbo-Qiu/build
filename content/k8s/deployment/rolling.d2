# Old pods (nginx 1.27) have dashed borders, new pods (1.28) solid ones.
grid-rows: 7
grid-columns: 5
grid-gap: 16
**.style.font-size: 20

r1: start {shape: text}
r1a: "1.27" {style.stroke-dash: 4}
r1b: "1.27" {style.stroke-dash: 4}
r1c: "1.27" {style.stroke-dash: 4}
r1d: "" {style.stroke-width: 0; style.fill: transparent}

r2: add a new pod {shape: text}
r2a: "1.27" {style.stroke-dash: 4}
r2b: "1.27" {style.stroke-dash: 4}
r2c: "1.27" {style.stroke-dash: 4}
r2d: "1.28"

r3: remove an old pod {shape: text}
r3a: "1.27" {style.stroke-dash: 4}
r3b: "1.27" {style.stroke-dash: 4}
r3c: "1.28"
r3d: "" {style.stroke-width: 0; style.fill: transparent}

r4: add a new pod {shape: text}
r4a: "1.27" {style.stroke-dash: 4}
r4b: "1.27" {style.stroke-dash: 4}
r4c: "1.28"
r4d: "1.28"

r5: remove an old pod {shape: text}
r5a: "1.27" {style.stroke-dash: 4}
r5b: "1.28"
r5c: "1.28"
r5d: "" {style.stroke-width: 0; style.fill: transparent}

r6: add a new pod {shape: text}
r6a: "1.27" {style.stroke-dash: 4}
r6b: "1.28"
r6c: "1.28"
r6d: "1.28"

r7: remove an old pod {shape: text}
r7a: "1.28"
r7b: "1.28"
r7c: "1.28"
r7d: "" {style.stroke-width: 0; style.fill: transparent}
