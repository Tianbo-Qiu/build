grid-rows: 3
grid-columns: 1
grid-gap: 32

sc: "sidecar: adds a feature" {
  direction: right
  app: "app"
  s: "log shipper"
  out: "log storage"
  app -> s: "log files"
  s -> out
}
amb: "ambassador: proxies outgoing calls" {
  direction: right
  app: "app"
  a: "proxy on\nlocalhost"
  out: "memcache\nshards"
  app -> a: "one memcache"
  a -> out: "many"
}
ad: "adapter: converts its output" {
  direction: right
  mon: "monitoring\nsystem"
  a: "exporter"
  app: "app"
  mon -> a: "scrapes\nmetrics"
  a -> app: "reads its\nown format"
}

**.style.font-size: 20
(** -> **)[*].style.font-size: 18
