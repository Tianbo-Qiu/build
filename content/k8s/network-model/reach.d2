grid-rows: 3
grid-columns: 1
grid-gap: 70

yes: "reach pod web" {
  grid-rows: 2
  grid-columns: 2
  grid-gap: 16
  a: "a container in\nthe same pod:\nlocalhost"
  b: "a pod on any node:\npod IP, no NAT"
  c: "the kubelet on\nweb's node:\nhealth checks"
  d: "another node:\nyes on kind,\nnot required"
}
mid: "" {
  style.fill: transparent
  style.stroke: transparent
  web: "pod web\n10.244.2.6"
}
no: "don't reach pod web" {
  grid-rows: 1
  grid-columns: 2
  grid-gap: 16
  a: "a pod denied by\na NetworkPolicy"
  b: "outside the cluster:\nno route to\nthe pod range"
}

yes -> mid.web: "connect"
no -> mid.web: "no connection"

**.style.font-size: 20
(** -> **)[*].style.font-size: 20
