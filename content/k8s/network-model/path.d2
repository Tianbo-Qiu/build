direction: down

w2: "node kind-worker2" {
  direction: down
  pod: "pod client: eth0 10.244.1.6"
  veth: "veth pair: the pod's eth0\nis one end, the node holds the other"
  rt: "node route table:\n10.244.2.0/24 via 172.21.0.4"
  pod -> veth -> rt
}
net: "network between nodes"
w1: "node kind-worker" {
  direction: down
  rt: "node route table:\n10.244.2.5 dev veth5f02253a"
  pod: "pod web: eth0 10.244.2.5"
  rt -> pod
}
w2.rt -> net -> w1.rt

