grid-rows: 2
grid-columns: 2
horizontal-gap: 160
vertical-gap: 110
(** -> **)[*].style.font-size: 20

probe: "Readiness probe\nof …-x8r2k fails"
pod: "Pod …-x8r2k\nnot Ready"
