grid-rows: 1
grid-columns: 2
grid-gap: 40

col: "" {
  style.fill: transparent
  style.stroke: transparent
  grid-columns: 1
  grid-gap: 40
n: "1. from the node" {
  grid-columns: 1
  grid-gap: 90
  sh: "shell on\nkind-worker:\ncurl 10.244.2.9"
  web: "nginx in pod web\n10.244.2.9"
  sh -> web: "seen as\n10.244.2.1"
}
p: "2. from a pod" {
  grid-columns: 1
  grid-gap: 90
  tmp: "pod tmp\n10.244.1.7\non kind-worker2"
  web: "nginx in pod web\n10.244.2.9"
  tmp -> web: "seen as\n10.244.1.7"
}
}
f: "3. port forwarding" {
  grid-columns: 1
  grid-gap: 80
  curl: "laptop:\ncurl localhost:8080"
  pf: "kubectl\nport-forward\npod/web 8080:80"
  api: "API server"
  kubelet: "kubelet on\nkind-worker"
  web: "nginx in pod web,\nvia localhost:80"
  curl -> pf
  pf -> api: "stream"
  api -> kubelet: "stream"
  kubelet -> web: "seen as\n127.0.0.1"
}

**.style.font-size: 20
(** -> **)[*].style.font-size: 18
