direction: down
**.style.font-size: 16

cup: "Venti, 20 fl oz" {
  grid-rows: 2
  grid-gap: 12
  water: "hot water" {width: 236}
  shots: {
    grid-columns: 4
    grid-gap: 8
    label: ""
    style.stroke-width: 0
    style.fill: transparent
    s1: "shot"
    s2: "shot"
    s3: "shot"
    s4: "shot"
  }
}
total: "4 × 75 = 300 mg caffeine\n3/4 of 400 mg a day"
cup -> total
